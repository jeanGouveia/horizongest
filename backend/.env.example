PORT=8080
ENVIRONMENT=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=horizongest
DB_USER=horizongest_user
DB_PASSWORD=horizongest_secure_password
DB_SSLMODE=disable
# JWT secrets must be at least 32 bytes (256 bits) with high entropy
# Generate secure secrets using: openssl rand -base64 32
JWT_PLATFORM_SECRET=<generate-secure-secret-min-32-bytes>
JWT_TENANT_SECRET=<generate-secure-secret-min-32-bytes>
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=horizongest.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE_PREFIX=horizongest
RABBITMQ_RETRY_COUNT=3
RABBITMQ_PUBLISHER_TIMEOUT=10s
RABBITMQ_RECONNECT_DELAY=5s

# Event Dispatcher Configuration
DISPATCHER_INTERVAL=5s
DISPATCHER_BATCH_SIZE=50
DISPATCHER_RETRY_COUNT=5
DISPATCHER_RETRY_BACKOFF=30s

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_IDLE_CONNS=10
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s

# Redis Idempotency Configuration
IDEMPOTENCY_TTL=24h
